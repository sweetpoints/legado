{
  "bookSourceUrl": "https://books.example.test",
  "bookSourceName": "Fixed conformance source",
  "searchUrl": "/search?key={{key}}&page={{page}}",
  "ruleSearch": {
    "bookList": ".book",
    "name": ".title@text",
    "bookUrl": "a@href"
  },
  "ruleBookInfo": {"name": "h1@text", "tocUrl": "a.toc@href"},
  "ruleToc": {"chapterList": ".chapter", "chapterName": "a@text", "chapterUrl": "a@href"},
  "ruleContent": {"content": ".content@text"}
}
