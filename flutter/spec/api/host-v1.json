  ],
  "types": {
    "RequestOptions": {
      "url": "string",
      "method": "string = GET",
      "headers": "Record<string,string>?; explicit replaces defaults",
      "body": "string?",
      "timeoutMs": "integer = 30000",
      "followRedirects": "boolean = true",
      "inheritHeaders": "boolean = true; only used when headers absent",
      "charset": "string?; override request-body encoding and response decoding"
    },
    "NetworkResponse": {
      "url": "string",
      "status": "integer",
      "headers": "Record<string,string>",
      "body": "string",
      "message": "string",
      "bytes": "integer[0..255][]",
      "multiHeaders": "Record<string,string[]>",
      "cookies": "string[] Set-Cookie"
    },
    "JsonValue": "null | boolean | number | string | JsonValue[] | Record<string,JsonValue>"
  },
  "scriptEntries": {
    "search": "search",
    "explore": "explore",
    "info": "getBookInfo",
    "toc": "getChapters",
    "content": "getContent"
  },
  "platformMethods": [
    {
      "name": "storage.read",
      "arguments": [
        {
          "name": "key",
          "type": "string"
        }
      ],
      "returns": "Promise<string|null>",
      "requires": "SourcePlatform"
    },
    {
      "name": "storage.write",
      "arguments": [
        {
          "name": "key",
          "type": "string"
        },
        {
          "name": "value",
          "type": "string|null"
        }
      ],
      "returns": "Promise<null>",
      "requires": "SourcePlatform"
    },
    {
      "name": "browser.open",
      "arguments": [
        {
          "name": "url",
          "type": "string"
        },
        {
          "name": "title",
          "type": "string?"
        }
      ],
      "returns": "Promise<{url:string,body:string,cookie?:string,cookies?:string[]}|null>",
      "requires": "Android Activity browser adapter",
      "taskBinding": "source_host injects current task ID",
      "cookieImport": "Set-Cookie values preferred; Cookie-header fallback scoped to host/response directory/HTTPS"
    }
  ],
  "sourceMetadata": {
    "maxConcurrentRequests": {
      "type": "integer",
      "default": 4,
      "minimum": 1
    },
    "requestIntervalMs": {
      "type": "integer",
      "default": 0,
      "minimum": 0
    }
  },
  "session": {
    "export": "exportSession(sourceId)",
    "import": "importSession(sourceId,{variables,cookies})",
    "automaticCorePersistence": false
  },
  "sourceHeaders": {
    "default": {},
    "inheritFor": [
      "stage HTTP",
      "net.get",
      "net.request without explicit headers"
    ],
    "explicitHeaders": "replace entire mapping",
    "reject": "Invalid header name or CR/LF value"
  },
  "utilityMethods": {
    "requires": "SourceUtilityHost adapter",
    "methods": {
      "encoding.base64EncodeWithFlags": "text, flags? -> string",
      "encoding.base64DecodeWithCharset": "text, charset? -> string|null",
      "encoding.base64DecodeWithFlags": "text, flags? -> string|null",
      "encoding.base64DecodeBytes": "text, flags? -> integer[]|null",
      "encoding.strToBytes": "text, charset? -> integer[]",
      "encoding.bytesToStr": "bytes, charset? -> string",
      "encoding.hexEncode": "text -> string",
      "encoding.hexDecode": "hex -> string",
      "encoding.hexDecodeBytes": "hex -> integer[]",
      "encoding.formEncode": "text, charset? -> string",
      "encoding.formDecode": "text, charset? -> string",
      "crypto.md5": "text -> string",
      "crypto.md5Short": "text -> string",
      "crypto.digestHex": "text, algorithm -> string",
      "crypto.digestBase64": "text, algorithm -> string",
      "encoding.unescapeHtml4": "text string -> string; single-pass semicolon-required HTML4 252 entities; not HTML5"
    },
    "allReturns": "Promise"
  },
  "httpRedirects": {
    "rewriteToGet": "POST on 301/302; any method on303",
    "removeHeadersCaseInsensitive": [
      "Content-Length",
      "Transfer-Encoding",
      "Content-Type",
      "Content-Encoding",
      "Content-Language",
      "Content-Location"
    ],
    "preserveBodyAndHeadersOn": [
      307,
      308
    ],
    "crossOriginRemoveHeaders": [
      "Authorization",
      "Cookie"
    ]
  },
  "stageBodyEncoding": {
    "default": "raw",
    "allowed": [
      "raw",
      "legacyFormUtf8"
    ],
    "legacyFormUtf8": "expand known placeholders before Java UTF8 per-component form encoding; input guard when this encoding or bodyTemplateMode legacyJsonString; only strings, booleans and JS-safe integers; unsafe chars/types fail before request",
    "invalidMode": "invalid_source",
    "unsafeTemplateInput": "legacy_body_template_requires_migration",
    "nullInput": "missing_input",
    "dartHelper": "encodeLegacyFormUtf8Body"
  },
  "stageBodyTemplateMode": {
    "default": "raw",
    "allowed": [
      "raw",
      "legacyJsonString"
    ],
    "legacyJsonString": "legacy JSON options string-body template input guard even with bodyEncoding raw; no implicit form encoding",
    "invalidMode": "invalid_source"
  }
}
