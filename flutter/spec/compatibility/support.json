{
  "specVersion": 1,
  "meaning": "Implementation capability inventory, not proof of device acceptance or complete Legado compatibility",
  "runtime": {
    "engine": "V8",
    "artifactRelease": "v14.3.92-15",
    "provider": "haroel/v8-build",
    "hookTargets": [
      "macos-arm64",
      "android-arm",
      "android-arm64",
      "android-x64"
    ],
    "unsupportedTargets": [
      "ios",
      "linux",
      "windows"
    ],
    "asyncHost": true,
    "legacySyncBridge": true,
    "contextLifetime": "per-evaluation",
    "defaultOldGenerationLimitMb": 64,
    "intl": false
  },
  "engine": {
    "operations": [
      "search",
      "explore",
      "info",
      "toc",
      "content"
    ],
    "extractors": [
      "css",
      "jsonpath",
      "xpath",
      "regex",
      "javascript",
      "explicit @legacy JSoup subset"
    ],
    "automaticNextPage": true,
    "rateLimit": true,
    "cookiePersistence": "Core export/import; Android source_host persists via PlatformSessionStore",
    "webViewCookieSynchronization": "browser.open result imported into HTTP jar; no continuous bidirectional synchronization",
    "paginationContract": "Explicit nextPage rule; maxPages default20, allowed1..1000; cycle/limit errors",
    "networkScheduling": {
      "maxConcurrentRequests": {
        "default": 4,
        "minimum": 1
      },
      "requestIntervalMs": {
        "default": 0,
        "minimum": 0
      },
      "queueCancellation": true,
      "redirects": "part of original request"
    },
    "browserCookieImport": {
      "setCookieArray": "Preserves supplied attributes; validates domain",
      "cookieHeader": "host-only, response directory path, HTTPS secure; original attributes unavailable"
    },
    "sessionExportImport": true,
    "responseCharsetDetection": [
      "Content-Type",
      "UTF8 BOM",
      "HTML meta",
      "UTF8 default"
    ],
    "staticHeaders": true,
    "parseHostMethods": [
      "getString",
      "getStringList",
      "getElement",
      "getElements"
    ],
    "parseNestedJavaScript": false,
    "stageRequestOptions": [
      "method",
      "body string template",
      "static headers replacement",
      "charset"
    ]
  },
  "legacy": {
    "status": "partial",
    "syncApis": [
      "java.ajax",
      "java.ajaxAll",
      "java.connect",
      "java.get(variable key or HTTP overload)",
      "java.post",
      "java.head",
      "java.put",
      "java.base64Encode",
      "java.base64Decode",
      "java.base64DecodeToByteArray",
      "java.strToBytes",
      "java.bytesToStr",
      "java.hexDecodeToByteArray",
      "java.hexDecodeToString",
      "java.hexEncodeToString",
      "java.md5Encode",
      "java.md5Encode16",
      "java.digestHex",
      "java.digestBase64Str",
      "java.encodeURI"
    ],
    "unsupportedApis": [
      "arbitrary Java classes",
      "unlisted methods and overloads",
      "legacy comma URL options",
      "skipRateLimit=true"
    ],
    "importStatuses": [
      "unverified",
      "manualRequired"
    ],
    "responseFacadeDifference": "body/url callable primitive facade is not strict-equality-equivalent to string properties",
    "staticHeaders": true,
    "dynamicHeaders": false,
    "domFacade": "read-only subset; no JVM identity or arbitrary methods; html() explicitly unsupported",
    "literalRequestOptions": {
      "format": "URL,{strict JSON object}",
      "keys": [
        "method",
        "body",
        "headers",
        "charset"
      ],
      "convertedFields": [
        "method",
        "body for POST",
        "static headers overlaid on source headers"
      ],
      "methodMapping": "POST/HEAD retained; other string maps GET",
      "manual": [
        "nonempty charset",
        "dynamic JavaScript",
        "unknown options",
        "templated form body",
        "non-UTF8 Content-Type",
        "noncanonical Content-Type case",
        "unknown placeholder"
      ],
      "stageCharsetFromLegacy": false
    }
  },
  "migration": {
    "verifiedAutomatically": false,
    "originalPreserved": true,
    "javascript": "restricted straight-line direct calls",
    "stageFieldScripts": true,
    "scriptLibraries": false,
    "urlScripts": false,
    "stageListScripts": true,
    "stageNextPageScripts": true,
    "fullAsyncCallGraphTransform": false
  },
  "androidBridge": {
    "protocolVersion": 1,
    "channel": "legado/source_engine",
    "incrementalResults": false,
    "silentFallback": false,
    "startupSelfCheck": "Actual V8 1 + 1 before ready",
    "startupError": "runtime_initialization_failed",
    "isolatedDebugApplicationId": "com.legado.app.fluttertest",
    "isolatedTestApplicationId": "com.legado.app.fluttertest.test",
    "enabledApkAbis": [
      "arm64-v8a"
    ],
    "sessionPersistence": {
      "formatVersion": 1,
      "perSourceModeIsolation": true,
      "sameSourceSerialExecution": true,
      "reservedPrefix": "__engine.session.",
      "errors": [
        "session_restore_failed",
        "session_write_failed"
      ],
      "commit": "finally after task, including error/cancel"
    }
  }
}
