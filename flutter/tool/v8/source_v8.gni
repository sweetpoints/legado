# Copied into the pinned official V8 checkout by build.py. The bridge and V8
# share Chromium's compiler, public header features, and C++ runtime.
# Only the stable sv8 C ABI is visible to Dart or the surrounding application.
template("source_v8_library") {
  shared_library(target_name) {
    output_name = "source_v8"
    sources = [ "//source_v8/source_v8.cpp" ]
    deps = [ "//:v8_monolith" ]
    configs += [ "//:external_config" ]
    if (is_android) {
      ldflags = [
        "-Wl,--no-undefined",
        "-Wl,--exclude-libs,ALL",
        "-Wl,--version-script=" +
            rebase_path("//source_v8/android_exports.map", root_build_dir),
        "-Wl,-z,max-page-size=16384",
      ]
      inputs = [ "//source_v8/android_exports.map" ]
      libs = [ "log", "dl", "m", "atomic" ]
    } else if (is_mac) {
      ldflags = [ "-Wl,-undefined,error" ]
      foreach(symbol, [
                "sv8_create",
                "sv8_start",
                "sv8_poll",
                "sv8_resolve",
                "sv8_sync_poll",
                "sv8_sync_reply",
                "sv8_cancel",
                "sv8_destroy",
                "sv8_free",
                "sv8_version",
              ]) {
        ldflags += [ "-Wl,-exported_symbol,_" + symbol ]
      }
    } else {
      assert(false, "source_v8 currently supports macOS and Android only")
    }
  }
}
